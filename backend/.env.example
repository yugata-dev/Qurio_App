# Use DATABASE_URL or the individual DB_* fields below.
DATABASE_URL=<postgresql-connection-url>

# Database connection fields used when DATABASE_URL is unset.
DB_USER=<database-user>
DB_HOST=<database-host>
DB_NAME=<database-name>
DB_PASSWORD=<database-password>
DB_PORT=<database-port>

# HTTP listen port; PORT takes precedence over SERVER_PORT.
PORT=<port>
SERVER_PORT=<server-port>

# Runtime mode, for example development or production.
NODE_ENV=<runtime-environment>

# Comma-separated list of allowed frontend origins.
FRONTEND_URL=<frontend-origin-list>

# Unique, high-entropy key for signing JWTs.
JWT_SECRET=<random-jwt-secret>
