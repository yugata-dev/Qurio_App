# ========================================
# Backend Environment Variables (Development Lokal)
# ========================================

# ---- Database ----
DATABASE_URL=

# ---- Server ----
PORT=5000
NODE_ENV=

# ---- CORS ----
# Origin yang diizinkan akses backend. Dipisah koma kalau lebih dari 1.
# Untuk development lokal: frontend di localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- JWT ----
# Secret key untuk signing token. Ganti dengan string random panjang.
JWT_SECRET=

# ---- Optional ----
# Kalau mau lihat log SQL di console
LOG_LEVEL=info