{
  "javascript.validate.enable": true,
  "typescript.validate.enable": true,
  "editor.showUnused": true,

  // Tambahan khusus untuk mengatur ekstensi Error Lens:
  // Hanya menampilkan "error" (merah), "warning" (kuning) akan disembunyikan
  "errorLens.enabledDiagnosticLevels": ["error"],

  "workbench.colorCustomizations": {
    "editorWarning.foreground": "#00000000",
    "editorWarning.border": "#00000000"
  },

  // Folder yang disembunyikan dari Explorer (file explorer)
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.cache": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.cache": true
  }
}
